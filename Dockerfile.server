FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY server server
COPY shared shared
COPY tsconfig.node.json tsconfig.server.json ./
RUN npx tsc -p tsconfig.server.json

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY package*.json ./
RUN npm ci --omit=dev
COPY --from=build /app/server-dist/server ./server
COPY --from=build /app/server-dist/shared ./shared
EXPOSE 3001
CMD ["node", "server/index.js"]
